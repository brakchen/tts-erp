# Copy only the needed entries into the server's private environment file.
# Never put the actual key in a browser, request body, task JSON, Git or logs.
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_MINIO_BUCKET=tts-erp-runninghub
RUNNINGHUB_MAX_BATCH_JOBS=2000
# Optional: an existing private directory with enough free space for raw/final/ZIP.
# RUNNINGHUB_SPOOL_DIR=/var/lib/tts-erp/runninghub
RUNNINGHUB_FFMPEG=ffmpeg
RUNNINGHUB_FFPROBE=ffprobe
# Workflow, credential reference, instance type and concurrency are persisted
# through the admin API; defaults are workflow 2111762608670990337 / plus / 5.
# Existing TTS_ERP_DB_URL, auth and MINIO_* settings remain required.
