[Unit]
Description=ttsERP RunningHub generation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tts-erp
EnvironmentFile=%h/.config/tts-erp/runtime.env
ExecStart=%h/tts-erp/.venv/bin/python -m tts_erp_v2.runninghub.worker
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
